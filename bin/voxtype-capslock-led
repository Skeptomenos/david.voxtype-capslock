#!/usr/bin/env python3
"""Drive the Caps Lock LED from Voxtype recording state."""

from __future__ import annotations

import glob
import json
import os
import subprocess
import sys


def led_dirs() -> list[str]:
    return sorted(glob.glob("/sys/class/leds/*::capslock"))


def write_text(path: str, value: str) -> bool:
    try:
        with open(path, "w", encoding="ascii") as handle:
            handle.write(value)
        return True
    except OSError:
        return False


def set_led(on: bool) -> None:
    brightness = "1" if on else "0"
    for path in led_dirs():
        write_text(os.path.join(path, "trigger"), "none")
        if write_text(os.path.join(path, "brightness"), brightness):
            continue
        name = os.path.basename(path)
        subprocess.run(
            ["brightnessctl", "--device", name, "--quiet", "set", brightness],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def recording(payload: dict) -> bool:
    state = str(payload.get("class") or payload.get("alt") or "").lower()
    return state in {"recording", "streaming"}


def follow() -> int:
    command = ["voxtype", "status", "--follow", "--format", "json"]
    process = subprocess.Popen(command, stdout=subprocess.PIPE, text=True)
    assert process.stdout is not None
    try:
        for line in process.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                payload = json.loads(line)
            except json.JSONDecodeError:
                continue
            set_led(recording(payload))
    except KeyboardInterrupt:
        pass
    finally:
        set_led(False)
        if process.poll() is None:
            process.terminate()
    return process.wait() or 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in {"--off", "off"}:
        set_led(False)
        return 0
    if len(sys.argv) > 1 and sys.argv[1] in {"--on", "on"}:
        set_led(True)
        return 0
    return follow()


if __name__ == "__main__":
    raise SystemExit(main())
